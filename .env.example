# Copia este archivo como .env (no se sube a git). Django lo lee al arrancar
# sin pisar variables que ya estén definidas en el sistema o en el servidor.
# Las líneas comentadas usan su valor por defecto; descoméntalas solo si las necesitas.

# --- Django ---
# Desarrollo local: DJANGO_DEBUG=True (usa una clave de desarrollo y permite localhost).
# Producción: DJANGO_DEBUG=False y DJANGO_SECRET_KEY obligatoria (sin ella Django no arranca).
DJANGO_DEBUG=True
# Genera una con: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=
# Dominios del backend separados por coma (en DEBUG se agregan localhost y 127.0.0.1)
# DJANGO_ALLOWED_HOSTS=api.repuestosrs.cl
# Orígenes del frontend, con https://, separados por coma (en DEBUG se agrega http://localhost:4200)
# DJANGO_CORS_ALLOWED_ORIGINS=https://repuestosrs.cl
# DJANGO_CSRF_TRUSTED_ORIGINS=https://repuestosrs.cl
# Solo con DEBUG=False. Lax si frontend y API comparten dominio (repuestosrs.cl / api.repuestosrs.cl);
# None si están en dominios distintos.
# DJANGO_COOKIE_SAMESITE=Lax

# --- Webpay Plus ---
# Con DEBUG=True y sin credenciales se usan las públicas de integración de Transbank.
# Con DEBUG=False las credenciales son obligatorias: sin ellas el pago muestra un error.
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# Integración: https://webpay3gint.transbank.cl (por defecto). Producción: https://webpay3g.transbank.cl
# WEBPAY_HOST=https://webpay3g.transbank.cl
# BACKEND_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:4200

# --- Correo ---
# Sin EMAIL_BACKEND y con DEBUG=True, los correos se imprimen en la terminal de runserver.
# Para enviar de verdad por SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# Para Gmail usa una "contraseña de aplicación", no la clave de la cuenta.
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=RepuestosRS <no-responder@repuestosrs.cl>
