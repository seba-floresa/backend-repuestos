# Copia este archivo como .env (no se sube a git) y exporta las variables antes de levantar Django.
# Las líneas comentadas usan su valor por defecto; descoméntalas solo si las necesitas.

# --- Webpay Plus (sin definir = ambiente de integración) ---
# WEBPAY_HOST=https://webpay3g.transbank.cl
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# BACKEND_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:4200

# --- Correo ---
# Sin EMAIL_BACKEND y con DEBUG=True, los correos se imprimen en la terminal de runserver.
# Para enviar de verdad por SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# Para Gmail usa una "contraseña de aplicación", no la clave de la cuenta.
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=RepuestosRS <no-responder@repuestosrs.cl>
